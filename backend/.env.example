# Copy to backend/.env and adjust.
# Local PostgreSQL only. Two ways to connect:
#
# (A) TCP with password (matches the project spec example):
# DATABASE_URL=postgresql+psycopg://vault:vault@localhost:5432/vault
#
# (B) Unix socket + peer auth as the current OS user (no password needed):
# DATABASE_URL=postgresql+psycopg:///vault
#
DATABASE_URL=postgresql+psycopg://vault:vault@localhost:5432/vault

# Single hardcoded admin password for this prototype.
# PRODUCTION: replace with real auth (OAuth/session/JWT + hashed users).
ADMIN_PASSWORD=changeme

# Absolute or relative path to the local image store.
DATA_DIR=../data

# Comma-separated CORS origins for the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Visible tiled watermark toggle. false = disabled (invisible LSB watermark is
# always applied regardless). Set true to re-enable the visible diagonal tile.
WATERMARK_VISIBLE=false

# --- Production-only (leave unset for local dev; see render.yaml) ---
# STATIC_DIR=/app/static       # path to the built frontend; FastAPI then serves the SPA same-origin
# COOKIE_SECURE=true           # send the device cookie only over HTTPS
# ADMIN_AUTH_ENABLED=true      # require HTTP Basic auth (user: admin) on /admin + /api/admin
